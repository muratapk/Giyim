@model IEnumerable<Giyim.Models.UrunVaryanti>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StokKodu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StokMiktari)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UrunId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Urun)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BedenId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Beden)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RenkId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Renk)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.StokKodu)
            </td>
            <td>
                @Html.DisplayFor(model => item.StokMiktari)
            </td>
            <td>
                @Html.DisplayFor(model => item.UrunId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Urun)
            </td>
            <td>
                @Html.DisplayFor(model => item.BedenId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Beden)
            </td>
            <td>
                @Html.DisplayFor(model => item.RenkId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Renk)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
