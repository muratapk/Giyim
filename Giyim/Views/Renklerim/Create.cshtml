@model Giyim.Models.Renk
@{
}
<h4>Yeni Renk Ekleme</h4>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="RenkAdi" class="control-label"></label>
        <input asp-for="RenkAdi" class="form-control" />
        <span asp-validation-for="RenkAdi" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RenkKodu" class="control-label"></label>
        <input asp-for="RenkKodu" class="form-control" />
        <span asp-validation-for="RenkKodu" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Ekle" class="btn btn-primary" />
    </div>
</form>