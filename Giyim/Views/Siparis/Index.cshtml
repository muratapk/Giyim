@model IEnumerable<Giyim.Models.Siparis>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SiparisNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SiparisTarihi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ToplamTutar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SiparisDurumu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KullaniciId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdresId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Adres)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TeslimatAdresi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SiparisDetaylari)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.SiparisNo)
            </td>
            <td>
                @Html.DisplayFor(model => item.SiparisTarihi)
            </td>
            <td>
                @Html.DisplayFor(model => item.ToplamTutar)
            </td>
            <td>
                @Html.DisplayFor(model => item.SiparisDurumu)
            </td>
            <td>
                @Html.DisplayFor(model => item.KullaniciId)
            </td>
            <td>
                @Html.DisplayFor(model => item.AdresId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Adres)
            </td>
            <td>
                @Html.DisplayFor(model => item.TeslimatAdresi)
            </td>
            <td>
                @Html.DisplayFor(model => item.SiparisDetaylari)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
